{
  // A Cloudflare Workers program, not a member of the host or client aggregate:
  // workerd global types replace Node's, so one program cannot hold both.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["@cloudflare/workers-types/experimental"],
    // This program carries workerd globals; no workspace package participates in it.
    "paths": {},
    "resolveJsonModule": true
  },
  "include": ["src"]
}
