{
  "name": "@deepseek-ai/dsh-cf-web",
  "description": "The dsh web GUI on Cloudflare: Worker entry, Host Durable Object, Sandbox container binding, and the workerd bundle of the host tree",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/cf-web"
  },
  "type": "module",
  "scripts": {
    "gate0": "node scripts/gate0.mjs",
    "parity": "node scripts/parity.mjs",
    "parity:check": "node scripts/parity.mjs --check",
    "build": "node scripts/parity.mjs && node scripts/build.mjs",
    "test:workerd": "node scripts/build-probe.mjs && vitest run --config vitest.workerd.config.ts",
    "deploy": "pnpm run build && wrangler deploy --containers-rollout=immediate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.2.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.125.0"
  },
  "files": [
    "composition-parity.md",
    "dist/worker.js",
    "dist/assets",
    "dist/generated",
    "wrangler.jsonc",
    "Dockerfile"
  ],
  "dependencies": {
    "@cloudflare/sandbox": "0.13.0-next.738.2",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-cf-bindings": "workspace:^",
    "@deepseek-ai/dsh-webserver-cf": "workspace:^",
    "@deepseek-ai/dsh-client-bundle-source-static": "workspace:^",
    "@deepseek-ai/dsh-agent-presets-static": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-typert-artifacts-static": "workspace:^"
  }
}
